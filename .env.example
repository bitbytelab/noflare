# Example environment variables for NoFlare
# Copy to `.env` and edit values as needed before running

DEBUG=false

# Concurrency
MAX_WORKERS=4

PORT=8191
HOST=0.0.0.0

LOCALE=en-US

SANDBOX=false
HEADLESS=false
DISABLE_MEDIA=true

LOG_LEVEL=INFO

# Persistent user data directory (host path when using Docker)
DATA_DIR=/data/noflare


