# Example environment variables for NoFlare
# Copy to `.env` and edit values as needed before running

# Concurrency
MAX_WORKERS=5

# Headless mode (true/false)
HEADLESS=true

# Locale
BROWSER_LOCALE=en-US

# Persistent user data directory (host path when using Docker)
DATA_DIR=/data/noflare

# Optional HTTP(s) proxy. Use IP-whitelisted proxies for proxy auth.
PROXY_SERVER=

# Logging
LOG_LEVEL=INFO

# HTTP port exposed by the service
PORT=8191
